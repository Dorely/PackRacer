{
  "name": "@packracer/desktop",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "PackRacer desktop operator application.",
  "author": "Dorely",
  "homepage": "https://github.com/Dorely/PackRacer",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dorely/PackRacer.git"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "debug": "electron-vite dev --inspect=5858 --remoteDebuggingPort=9222 --sourcemap",
    "build": "npm run typecheck && electron-vite build",
    "pack:win": "npm run build && electron-builder --config electron-builder.yml --win dir --x64",
    "dist:win": "npm run build && electron-builder --config electron-builder.yml --win nsis --x64 --publish never",
    "preview": "electron-vite preview",
    "typecheck": "tsc --build --pretty false"
  },
  "dependencies": {
    "@types/sql.js": "^1.4.11",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "serialport": "^13.0.0",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "42.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.3"
  }
}
